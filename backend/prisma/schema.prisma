datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ────────────────────────────────
// Enums
// ────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ImportSourceType {
  EXCEL
  CSV
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum StockReservationStatus {
  RESERVED
  RELEASED
  FULFILLED
}

// ────────────────────────────────
// Tenant & Users
// ────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  clients             Client[]
  deals               Deal[]
  stockItems          StockItem[]
  importJobs          ImportJob[]
  importFieldMappings ImportFieldMapping[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assignedDeals Deal[] @relation("AssignedUser")
  refreshTokens RefreshToken[]

  @@index([tenantId])
}

// ────────────────────────────────
// CRM core: clients, contacts, deals
// ────────────────────────────────

model Client {
  id        String   @id @default(uuid())
  name      String
  industry  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contacts Contact[]
  deals    Deal[]

  @@index([tenantId])
}

model Contact {
  id        String   @id @default(uuid())
  fullName  String
  roleTitle String? // например "закупщик", "инженер", "финансист"
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  tenantId String
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  dealContacts DealContact[]

  @@index([clientId])
  @@index([tenantId])
}

model Deal {
  id        String    @id @default(uuid())
  title     String
  stage     DealStage @default(LEAD)
  value     Decimal   @db.Decimal(12, 2)
  currency  String    @default("USD")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assignedUserId String?
  assignedUser   User?   @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  stageHistory      DealStageHistory[]
  dealContacts      DealContact[]
  bomItems          DealBomItem[]
  stockReservations StockReservation[]

  @@index([tenantId])
  @@index([clientId])
}

// История переходов по стадиям — для аналитики воронки
model DealStageHistory {
  id        String    @id @default(uuid())
  stage     DealStage
  enteredAt DateTime  @default(now())
  exitedAt  DateTime?

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// Многодольные сделки: несколько контактов на одну сделку
model DealContact {
  id        String @id @default(uuid())
  roleInDeal String? // например "принимает решение", "технический контакт"

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([dealId, contactId])
  @@index([contactId])
}

// ────────────────────────────────
// Склад и BOM (плоский список, без рекурсии — v1.1 добавит дерево)
// ────────────────────────────────

model StockItem {
  id                String  @id @default(uuid())
  sku               String
  name              String
  unit              String // например "pcs", "kg", "m"
  unitCost          Decimal @db.Decimal(10, 2)
  quantityOnHand    Decimal @default(0) @db.Decimal(12, 3)
  quantityReserved  Decimal @default(0) @db.Decimal(12, 3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  dealBomItems      DealBomItem[]
  stockReservations StockReservation[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

// Плоский список компонентов спецификации на конкретную сделку
model DealBomItem {
  id       String  @id @default(uuid())
  quantity Decimal @db.Decimal(12, 3)

  // Цена фиксируется на момент добавления в BOM, чтобы дальнейшие
  // изменения цен на складе не искажали уже посчитанную себестоимость сделки
  unitCostSnapshot Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([dealId])
  @@index([stockItemId])
}

// Журнал резервирований остатков под сделку
model StockReservation {
  id        String                  @id @default(uuid())
  quantity  Decimal                 @db.Decimal(12, 3)
  status    StockReservationStatus  @default(RESERVED)
  createdAt DateTime                @default(now())

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([dealId])
  @@index([stockItemId])
}

// ────────────────────────────────
// Импорт данных (Excel/CSV)
// ────────────────────────────────

model ImportJob {
  id          String           @id @default(uuid())
  sourceType  ImportSourceType
  status      ImportStatus     @default(PENDING)
  fileName    String
  rowsTotal   Int              @default(0)
  rowsSuccess Int              @default(0)
  rowsFailed  Int              @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime         @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Сохранённая настройка сопоставления колонок, чтобы не настраивать заново при каждой загрузке
model ImportFieldMapping {
  id         String           @id @default(uuid())
  sourceType ImportSourceType
  mapping    Json

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceType])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}